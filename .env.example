# TeraClip Studio — copy this file to .env.local and fill in what you need.
# Everything below is optional. The local pipeline works with no cloud key.

# ── Gemini (optional) ────────────────────────────────────────────────────────
# Used only for the editorial "which moments are worth clipping" pass.
# Leave empty to stay fully local. Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias.
GEMINI_API=
GEMINI_MODEL=gemini-2.5-flash
# Hard daily ceiling, shared by every project. Set 0 to disable cloud calls.
GEMINI_DAILY_LIMIT=40

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8484

# ── Storage ──────────────────────────────────────────────────────────────────
# Both are relative to the project folder unless you provide an absolute path.
DATA_DIR=data
TOOLS_DIR=tools
MAX_UPLOAD_BYTES=6442450944

# ── Local speech ─────────────────────────────────────────────────────────────
# 0 = auto (uses the logical core count, capped at 8).
# A value above 0 forces that thread count when Settings leaves the field at 0.
ASR_THREADS=0
WHISPER_RELEASE=b5454
# Point at your own whisper-cli build if the automatic Windows download is not
# right for this machine (macOS/Linux users normally do this).
# WHISPER_PATH=tools/whisper/whisper-cli
# WHISPER_CUDA=1

# ── Source downloads / cookies ───────────────────────────────────────────────
# YTDLP_PATH=tools/yt-dlp.exe
# YTDLP_COOKIES_BROWSER=chrome
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt

# ── Media tools (normally resolved from ffmpeg-static / ffprobe-static) ──────
# FFMPEG_PATH=
# FFPROBE_PATH=
